{
 "buildCommand":"node tools/build-design.mjs",
 "outputDirectory":"dist",
 "headers":[
  {"source":"/design-system/(.*)","headers":[{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cache-Control","value":"no-cache"}]},
  {"source":"/assets/(.*)","headers":[{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cache-Control","value":"public, max-age=3600"}]},
  {"source":"/assets/managed/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
  {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-cache"}]}
 ]
}
