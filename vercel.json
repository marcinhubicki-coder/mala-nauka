{
  "buildCommand": "node tools/build-design.mjs && node --test tests/*.test.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/design-system/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/managed/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/scenes/:path*",
      "destination": "https://mala-nauka-assets.vercel.app/assets/scenes/:path*"
    },
    {
      "source": "/assets/flags/:path*",
      "destination": "https://mala-nauka-assets.vercel.app/assets/flags/:path*"
    },
    {
      "source": "/assets/managed/:path*",
      "destination": "https://mala-nauka-assets.vercel.app/assets/managed/:path*"
    }
  ]
}
